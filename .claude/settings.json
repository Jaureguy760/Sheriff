{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "version": "1.0.0",
    "description": "Web Development domain profile - CORE (22) + WEB (32) = 54 plugins",
    "model": "claude-opus-4-6-20250116",
    "thinking": { "enabled": true },
    "autoCheckpoint": true,
    "permissionMode": "plan",
    "env": {
        "ENABLE_TOOL_SEARCH": "auto:5",
        "MAX_MCP_OUTPUT_TOKENS": "50000",
        "MAX_THINKING_TOKENS": "31999"
    },
    "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": true },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/dev/claude/infra/claude-governance/hooks/branch-protection.sh",
                        "timeout": 10,
                        "statusMessage": "Running branch protection check..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun run format 2>/dev/null || npm run format 2>/dev/null || true",
                        "async": true,
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "~/dev/claude/infra/claude-governance/hooks/test-gate.sh",
                        "statusMessage": "Running test gate..."
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "velocity-workflow@velocity-tools": true,
        "commit-commands@claude-plugins-official": true,
        "code-review@claude-plugins-official": true,
        "ralph-loop@claude-plugins-official": true,
        "hookify@claude-plugins-official": true,
        "claude-mem@claude-mem": true,
        "claude-md-management@claude-plugins-official": true,
        "claude-code-setup@claude-plugins-official": true,
        "agent-sdk-dev@claude-plugins-official": true,
        "plugin-dev@claude-plugins-official": true,
        "pr-review-toolkit@claude-plugins-official": true,
        "feature-dev@claude-plugins-official": true,
        "playground@claude-plugins-official": true,
        "pyright-lsp@claude-plugins-official": true,
        "typescript-lsp@claude-plugins-official": true,
        "coding-tutor@claude-plugins-official": true,
        "context7@anthropic-agent-skills": true,
        "context7-enhanced@anthropic-agent-skills": true,
        "devops-automation@claude-plugins-official": true,
        "velocity-workflow@hordago-plugins": true,
        "compound-engineering@compound-engineering": true,
        "planning-with-files@planning-with-files": true,
        "nextjs-vercel-pro@claude-plugins-official": true,
        "supabase-toolkit@claude-plugins-official": true,
        "stripe@claude-plugins-official": true,
        "posthog@claude-plugins-official": true,
        "figma@claude-plugins-official": true,
        "document-skills@claude-plugins-official": true,
        "example-skills@claude-plugins-official": true,
        "cloudflare@cloudflare": true,
        "github@composio": true,
        "gmail@composio": true,
        "google-calendar@composio": true,
        "google-docs@composio": true,
        "google-drive@composio": true,
        "google-sheets@composio": true,
        "google-slides@composio": true,
        "slack@composio": true,
        "notion@composio": true,
        "linear@composio": true,
        "jira@composio": true,
        "confluence@composio": true,
        "airtable@composio": true,
        "discord@composio": true,
        "twilio@composio": true,
        "zapier@composio": true,
        "nextjs-template@claude-code-templates": true,
        "react-template@claude-code-templates": true,
        "fullstack-template@claude-code-templates": true,
        "api-template@claude-code-templates": true,
        "supabase-template@claude-code-templates": true,
        "tailwind-template@claude-code-templates": true
    },
